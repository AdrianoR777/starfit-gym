# --- Sitio ---
NEXT_PUBLIC_SITE_URL=https://tudominio.pe
NEXT_PUBLIC_GYM_NAME="Star Fit Gym"
NEXT_PUBLIC_GYM_PHONE=519XXXXXXXX        # WhatsApp sin "+"

# --- Supabase (obligatorio) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=               # SOLO servidor. Nunca exponer.

# --- Acceso QR ---
QR_SIGNING_SECRET=                       # openssl rand -base64 48
REQUIRE_STAFF_MFA=true                   # false solo en desarrollo

# --- Pagos Culqi (usar llaves de integración sk_test/pk_test para sandbox) ---
NEXT_PUBLIC_CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_WEBHOOK_SECRET=                    # se añade como ?k=... a la URL del webhook

# --- Pendientes (no implementados aún) ---
RESEND_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Datos públicos del gimnasio (copiar de Instagram @sstarfitgym) ---
NEXT_PUBLIC_LOGO_URL=                    # o colocar public/brand/logo.png
NEXT_PUBLIC_GYM_ADDRESS=
NEXT_PUBLIC_GYM_HOURS=
NEXT_PUBLIC_GYM_BIO=

# --- Instagram Graph API (logo, bio y publicaciones automáticas) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=                   # ID de la cuenta IG profesional vinculada a tu app de Meta
INSTAGRAM_USERNAME=sstarfitgym

# --- Tareas automáticas (Vercel Cron envía este valor como Bearer) ---
CRON_SECRET=                             # openssl rand -hex 32
